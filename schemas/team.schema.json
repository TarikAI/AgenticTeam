{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticteam.local/schemas/team.schema.json",
  "title": "AgenticTeam manifest",
  "type": "object",
  "required": ["version", "name", "description", "defaults", "agents", "presets", "workflows", "harnesses"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "defaults": {
      "type": "object",
      "required": ["harness", "preset", "autonomy", "entry_mode", "context_method", "max_concurrent_agents", "max_task_retries"],
      "properties": {
        "autonomy": {"enum": ["autonomous", "supervised", "hitl"]},
        "entry_mode": {"enum": ["adaptive", "idea", "plan-given", "execute-only"]},
        "context_method": {"enum": ["adaptive", "bmad-progressive"]},
        "max_concurrent_agents": {"type": "integer", "minimum": 1},
        "max_task_retries": {"type": "integer", "minimum": 0}
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/agent"}
    },
    "presets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/preset"}
    },
    "workflows": {"type": "object", "minProperties": 1},
    "harnesses": {"type": "object", "minProperties": 1},
    "installation": {
      "type": "object",
      "required": ["harness", "preset", "installed_agents", "installed_at"],
      "properties": {
        "installed_agents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "required": ["id", "file", "department", "tier", "access", "reports_to", "capabilities"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "file": {"type": "string", "pattern": "^agents/.+\\.md$"},
        "department": {"type": "string", "minLength": 1},
        "tier": {"enum": ["deep", "standard", "fast"]},
        "access": {"enum": ["read-only", "workspace-write", "orchestrate"]},
        "reports_to": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "activate_when": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "limitations": {"type": "string"}
      },
      "additionalProperties": false
    },
    "preset": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "agents": {
          "oneOf": [
            {"const": "all"},
            {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
          ]
        },
        "departments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "anyOf": [{"required": ["agents"]}, {"required": ["departments"]}],
      "additionalProperties": false
    }
  }
}
