{
  "$schema": "schemas/team.schema.json",
  "version": "2.0.0",
  "name": "AgenticTeam",
  "description": "A portable, evidence-gated AI delivery organization with native harness adapters, progressive context, fusion councils, and safe autonomy.",
  "defaults": {
    "harness": "claude-code",
    "preset": "full-company",
    "autonomy": "hitl",
    "entry_mode": "adaptive",
    "context_method": "adaptive",
    "max_concurrent_agents": 6,
    "max_task_retries": 2,
    "context_target_tokens": {"min": 2000, "max": 8000}
  },
  "agents": [
    {"id":"ceo","file":"agents/leadership/ceo.md","department":"leadership","tier":"deep","access":"orchestrate","reports_to":"human-owner","capabilities":["intake","routing","gates","arbitration","reporting"]},
    {"id":"cto-architect","file":"agents/leadership/cto-architect.md","department":"leadership","tier":"deep","access":"workspace-write","reports_to":"ceo","capabilities":["architecture","contracts","technology-selection"]},
    {"id":"product-manager","file":"agents/leadership/product-manager.md","department":"leadership","tier":"deep","access":"workspace-write","reports_to":"ceo","capabilities":["product-definition","requirements","scope"]},
    {"id":"delivery-lead","file":"agents/leadership/delivery-lead.md","department":"leadership","tier":"deep","access":"orchestrate","reports_to":"ceo","capabilities":["task-graph","dispatch","integration","retrospective"]},

    {"id":"backend-lead","file":"agents/engineering/backend-lead.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"delivery-lead","capabilities":["backend","review","contracts"]},
    {"id":"backend-engineer","file":"agents/engineering/backend-engineer.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"backend-lead","capabilities":["backend","api","services"]},
    {"id":"frontend-lead","file":"agents/engineering/frontend-lead.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"delivery-lead","capabilities":["frontend","review","design-system"]},
    {"id":"frontend-engineer","file":"agents/engineering/frontend-engineer.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"frontend-lead","capabilities":["frontend","ui","browser"]},
    {"id":"fullstack-engineer","file":"agents/engineering/fullstack-engineer.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"delivery-lead","capabilities":["fullstack","vertical-slice","prototype"]},
    {"id":"database-engineer","file":"agents/engineering/database-engineer.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"backend-lead","capabilities":["database","schema","migrations"]},
    {"id":"devops-engineer","file":"agents/engineering/devops-engineer.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"delivery-lead","capabilities":["ci","infrastructure","deployment"]},
    {"id":"security-engineer","file":"agents/engineering/security-engineer.md","department":"engineering","tier":"deep","access":"read-only","reports_to":"delivery-lead","capabilities":["threat-model","security-review","abuse-cases"]},
    {"id":"qa-lead","file":"agents/engineering/qa-lead.md","department":"engineering","tier":"deep","access":"read-only","reports_to":"delivery-lead","capabilities":["test-strategy","acceptance","release-gate"]},
    {"id":"test-engineer","file":"agents/engineering/test-engineer.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"qa-lead","capabilities":["test-automation","regression","e2e"]},
    {"id":"code-reviewer","file":"agents/engineering/code-reviewer.md","department":"engineering","tier":"deep","access":"read-only","reports_to":"delivery-lead","capabilities":["code-review","correctness","maintainability"]},
    {"id":"integration-engineer","file":"agents/engineering/integration-engineer.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"backend-lead","capabilities":["integrations","webhooks","payments"]},
    {"id":"ai-ml-engineer","file":"agents/engineering/ai-ml-engineer.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"backend-lead","capabilities":["ai","ml","evals","rag"]},
    {"id":"mobile-engineer","file":"agents/engineering/mobile-engineer.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"frontend-lead","capabilities":["mobile","ios","android"]},
    {"id":"ux-ui-designer","file":"agents/engineering/ux-ui-designer.md","department":"engineering","tier":"standard","access":"workspace-write","reports_to":"frontend-lead","capabilities":["ux","ui","design-system"]},

    {"id":"build-integrator","file":"agents/specialists/build-integrator.md","department":"specialists","tier":"deep","access":"workspace-write","reports_to":"delivery-lead","capabilities":["merge","integration","conflict-resolution"],"activate_when":["parallel-writers","multi-worktree"]},
    {"id":"platform-admin-engineer","file":"agents/specialists/platform-admin-engineer.md","department":"specialists","tier":"standard","access":"workspace-write","reports_to":"delivery-lead","capabilities":["admin-console","backoffice","operations"],"activate_when":["admin","moderation","operations"]},
    {"id":"sre-engineer","file":"agents/specialists/sre-engineer.md","department":"specialists","tier":"deep","access":"workspace-write","reports_to":"delivery-lead","capabilities":["reliability","incidents","slo","backup"],"activate_when":["production","availability","on-call"]},
    {"id":"performance-engineer","file":"agents/specialists/performance-engineer.md","department":"specialists","tier":"deep","access":"read-only","reports_to":"delivery-lead","capabilities":["profiling","load-test","performance-budget"],"activate_when":["scale","latency","high-traffic"]},
    {"id":"accessibility-specialist","file":"agents/specialists/accessibility-specialist.md","department":"specialists","tier":"deep","access":"read-only","reports_to":"qa-lead","capabilities":["accessibility","wcag","assistive-tech"],"activate_when":["user-interface","public-sector","accessibility"]},
    {"id":"privacy-engineer","file":"agents/specialists/privacy-engineer.md","department":"specialists","tier":"deep","access":"read-only","reports_to":"delivery-lead","capabilities":["privacy","data-minimization","retention"],"activate_when":["pii","health-data","financial-data","children"]},
    {"id":"release-manager","file":"agents/specialists/release-manager.md","department":"specialists","tier":"standard","access":"orchestrate","reports_to":"delivery-lead","capabilities":["release","rollback","change-management"],"activate_when":["production-release","multi-service"]},
    {"id":"analytics-engineer","file":"agents/specialists/analytics-engineer.md","department":"specialists","tier":"standard","access":"workspace-write","reports_to":"delivery-lead","capabilities":["product-analytics","events","metrics","experiments"],"activate_when":["analytics","experiments","growth"]},
    {"id":"finops-engineer","file":"agents/specialists/finops-engineer.md","department":"specialists","tier":"standard","access":"read-only","reports_to":"delivery-lead","capabilities":["cost-model","cloud-cost","unit-economics"],"activate_when":["cloud","high-volume","budget"]},
    {"id":"localization-specialist","file":"agents/specialists/localization-specialist.md","department":"specialists","tier":"standard","access":"workspace-write","reports_to":"product-manager","capabilities":["i18n","l10n","rtl","locale-testing"],"activate_when":["multilingual","international","rtl"]},
    {"id":"compliance-advisor","file":"agents/specialists/compliance-advisor.md","department":"specialists","tier":"deep","access":"read-only","reports_to":"ceo","capabilities":["compliance","evidence","policy-mapping"],"activate_when":["regulated","gdpr","hipaa","pci"],"limitations":"Advisory only; not a substitute for qualified legal counsel."},
    {"id":"context-engineer","file":"agents/specialists/context-engineer.md","department":"specialists","tier":"deep","access":"workspace-write","reports_to":"delivery-lead","capabilities":["progressive-context","context-packs","prompt-architecture"],"activate_when":["bmad","progressive-context","large-project"]},
    {"id":"system-mapper","file":"agents/specialists/system-mapper.md","department":"specialists","tier":"deep","access":"read-only","reports_to":"cto-architect","capabilities":["system-map","blast-radius","brownfield"],"activate_when":["existing-codebase","migration","refactor"]},
    {"id":"fusion-moderator","file":"agents/specialists/fusion-moderator.md","department":"specialists","tier":"deep","access":"orchestrate","reports_to":"ceo","capabilities":["fusion","debate","synthesis","dissent"],"activate_when":["fusion","debate","council"]},
    {"id":"customer-success-strategist","file":"agents/specialists/customer-success-strategist.md","department":"specialists","tier":"standard","access":"workspace-write","reports_to":"product-manager","capabilities":["onboarding","support","retention","service-design"],"activate_when":["saas","customer-support","onboarding"]},

    {"id":"tech-writer","file":"agents/support/tech-writer.md","department":"support","tier":"fast","access":"workspace-write","reports_to":"delivery-lead","capabilities":["documentation","runbook","tutorial"]},
    {"id":"research-agent","file":"agents/support/research-agent.md","department":"support","tier":"standard","access":"read-only","reports_to":"delivery-lead","capabilities":["research","sources","current-standards"]},
    {"id":"skill-scout","file":"agents/support/skill-scout.md","department":"support","tier":"fast","access":"read-only","reports_to":"delivery-lead","capabilities":["skill-discovery","capability-audit","supply-chain"]},

    {"id":"cmo","file":"agents/marketing/cmo.md","department":"marketing","tier":"deep","access":"orchestrate","reports_to":"ceo","capabilities":["gtm","campaigns","marketing-routing"]},
    {"id":"brand-strategist","file":"agents/marketing/brand-strategist.md","department":"marketing","tier":"standard","access":"workspace-write","reports_to":"cmo","capabilities":["brand","positioning","voice"]},
    {"id":"content-marketer","file":"agents/marketing/content-marketer.md","department":"marketing","tier":"fast","access":"workspace-write","reports_to":"cmo","capabilities":["content","editorial","copy"]},
    {"id":"seo-specialist","file":"agents/marketing/seo-specialist.md","department":"marketing","tier":"standard","access":"workspace-write","reports_to":"cmo","capabilities":["seo","search","content-architecture"]},
    {"id":"performance-marketer","file":"agents/marketing/performance-marketer.md","department":"marketing","tier":"standard","access":"workspace-write","reports_to":"cmo","capabilities":["paid-media","campaign-model","measurement"]},
    {"id":"ugc-creative","file":"agents/marketing/ugc-creative.md","department":"marketing","tier":"fast","access":"workspace-write","reports_to":"cmo","capabilities":["ugc","creative","scripts"]},
    {"id":"social-media-manager","file":"agents/marketing/social-media-manager.md","department":"marketing","tier":"fast","access":"workspace-write","reports_to":"cmo","capabilities":["social","community","calendar"]},
    {"id":"email-marketing-specialist","file":"agents/marketing/email-marketing-specialist.md","department":"marketing","tier":"fast","access":"workspace-write","reports_to":"cmo","capabilities":["email","lifecycle","deliverability"]},
    {"id":"growth-analyst","file":"agents/marketing/growth-analyst.md","department":"marketing","tier":"standard","access":"read-only","reports_to":"cmo","capabilities":["growth","attribution","experiments"]}
  ],
  "presets": {
    "full-company": {"description":"Every available role; specialists activate conditionally.","agents":"all"},
    "full-platform": {"description":"All leadership, engineering, support, and specialists.","departments":["leadership","engineering","support","specialists"]},
    "platform-core": {"description":"Core product delivery organization.","agents":["ceo","product-manager","cto-architect","delivery-lead","fullstack-engineer","ux-ui-designer","qa-lead","code-reviewer","security-engineer","devops-engineer","tech-writer"]},
    "fusion-product-council": {"description":"Independent product and technical proposals with moderated synthesis.","agents":["fusion-moderator","product-manager","cto-architect","ux-ui-designer","security-engineer","research-agent","finops-engineer"]},
    "regulated-platform": {"description":"Delivery team plus privacy and compliance specialists.","agents":["ceo","product-manager","cto-architect","delivery-lead","backend-lead","frontend-lead","database-engineer","security-engineer","privacy-engineer","compliance-advisor","qa-lead","accessibility-specialist","devops-engineer","release-manager","tech-writer"]},
    "scale-readiness": {"description":"Architecture, reliability, performance, cost, and release review.","agents":["cto-architect","sre-engineer","performance-engineer","security-engineer","privacy-engineer","finops-engineer","code-reviewer","release-manager"]},
    "audit": {"description":"Independent product, architecture, quality, security, privacy, and accessibility audit.","agents":["cto-architect","system-mapper","code-reviewer","security-engineer","privacy-engineer","qa-lead","accessibility-specialist"]},
    "marketing-only": {"description":"Complete marketing organization.","departments":["marketing"]},
    "launch": {"description":"Core platform team plus go-to-market and customer success.","agents":["ceo","product-manager","cto-architect","delivery-lead","fullstack-engineer","ux-ui-designer","qa-lead","security-engineer","devops-engineer","release-manager","cmo","brand-strategist","content-marketer","performance-marketer","ugc-creative","growth-analyst","customer-success-strategist"]}
  },
  "workflows": {
    "build":{"skill":"skills/agentic-build","entry_modes":["idea","plan-given","execute-only"]},
    "fusion":{"skill":"skills/fusion-council","modes":["council","debate","red-team","design-studio"]},
    "progressive":{"skill":"skills/bmad-progressive","method":"BMAD-inspired progressive context with ICM-style routing contracts"},
    "verify":{"skill":"skills/agentic-verify"},
    "learn":{"skill":"skills/agentic-learn"}
  },
  "harnesses": {
    "claude-code":{"agent_dir":".claude/agents","skill_dir":".claude/skills","native_subagents":true},
    "codex":{"agent_dir":".codex/agents","skill_dir":".agents/skills","native_subagents":true},
    "opencode":{"agent_dir":".opencode/agents","skill_dir":".agents/skills","native_subagents":true},
    "antigravity":{"agent_dir":".agents","skill_dir":".agents/skills","workflow_dir":".agents/workflows","rule_dir":".agents/rules","native_subagents":false},
    "gemini-cli":{"agent_dir":".gemini/agents","skill_dir":".agents/skills","native_subagents":true},
    "pi":{"context_file":"AGENTS.md","skill_dir":".pi/skills","prompt_dir":".pi/prompts","native_subagents":false},
    "generic":{"agent_dir":".agentic-team/agents","skill_dir":".agents/skills","native_subagents":false}
  }
}
