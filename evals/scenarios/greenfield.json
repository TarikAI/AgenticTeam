{
  "name": "greenfield-autonomous-adaptive",
  "description": "Idea to completion in autonomous/adaptive: every stage exit needs its evidence; build work needs a declared check that completion runs; release waits for the human.",
  "steps": [
    {"note": "an autonomous run needs a spend ceiling", "cli": ["init-run", "--name", "Greenfield", "--run-id", "green", "--autonomy", "autonomous", "--entry", "idea", "--context", "adaptive"], "exit": 1, "contains": "spend ceiling"},
    {"cli": ["init-run", "--name", "Greenfield", "--run-id", "green", "--autonomy", "autonomous", "--entry", "idea", "--context", "adaptive", "--budget", "usd=20"]},
    {"note": "empty intake cannot exit", "cli": ["advance"], "exit": 1, "contains": "BRIEF.md is missing"},
    {"write": "RUN/BRIEF.md", "text": "# Brief\n\nA task tracker.\n\n- AC-1: a user can add a task\n"},
    {"cli": ["advance"], "contains": "01_product"},
    {"cli": ["advance"], "contains": "02_solution"},
    {"note": "architecture needs an independent review", "cli": ["advance"], "exit": 1, "contains": "independent-review"},
    {"cli": ["add-task", "--id", "REVIEW", "--title", "Review the architecture", "--owner", "code-reviewer", "--action", "inspect"]},
    {"cli": ["claim", "--task", "REVIEW", "--agent", "code-reviewer"]},
    {"cli": ["complete", "--task", "REVIEW", "--agent", "code-reviewer", "--evidence", "note:no blockers"]},
    {"cli": ["advance"], "contains": "03_readiness"},
    {"cli": ["advance"], "contains": "04_build"},
    {"note": "build work must declare an acceptance check", "cli": ["add-task", "--id", "T0", "--title", "Add task endpoint", "--owner", "backend-engineer", "--path", "src/api"], "exit": 1, "contains": "--check"},
    {"cli": ["add-task", "--id", "T1", "--title", "Add task endpoint", "--owner", "backend-engineer", "--path", "src/api", "--check", "\"PYTHON\" \"PROJECT/check.py\""]},
    {"cli": ["claim", "--task", "T1", "--agent", "backend-engineer"]},
    {"note": "completion runs the check itself; a failing check refuses the claim of done", "cli": ["complete", "--task", "T1", "--agent", "backend-engineer", "--evidence", "note:tests pass"], "exit": 1, "contains": "no passing exec record"},
    {"task": {"id": "T1", "status": "claimed"}},
    {"write": "PROJECT/check.py", "text": "print('2 passed')\n"},
    {"cli": ["complete", "--task", "T1", "--agent", "backend-engineer", "--evidence", "note:tests pass"], "contains": "Completed T1"},
    {"task": {"id": "T1", "status": "completed"}},
    {"cli": ["advance"], "contains": "05_verify"},
    {"note": "a builder cannot be the verifier", "write": "RUN/VERIFICATION.md", "text": "Verdict: PASS\nVerifier: backend-engineer\nVerified-SHA: none\n\n# Verification\n"},
    {"cli": ["advance"], "exit": 1, "contains": "independent"},
    {"write": "RUN/VERIFICATION.md", "text": "Verdict: PASS\nVerifier: qa-lead\nVerified-SHA: none\n\n# Verification\n\n| AC-1 | exec T1-2 | pass | cmd:T1-2 |\n"},
    {"cli": ["advance"], "contains": "06_release"},
    {"note": "release is always human", "cli": ["advance"], "exit": 2},
    {"state": {"status": "waiting-human", "stage": "06_release"}},
    {"human": ["approve", "--checkpoint", "CP-001", "--by", "Owner", "--decision", "ship it"]},
    {"cli": ["advance"], "contains": "07_learn"},
    {"cli": ["advance"], "exit": 1, "contains": "DELIVERY-REPORT.md is missing"},
    {"cli": ["report"], "contains": "DELIVERY-EVIDENCE.md"},
    {"write": "RUN/DELIVERY-REPORT.md", "text": "# Delivery report\n\nOutcome: AC-1 verified (cmd:T1-2).\n"},
    {"cli": ["advance"], "contains": "complete"},
    {"state": {"status": "complete"}},
    {"human": ["audit", "verify", "--by", "Owner"], "contains": "signed decision"}
  ]
}
